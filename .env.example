# AI client configuration for the workflow tooling (tools/ai).
# Export these variables in your shell or configure your runner to load .env.
# The current client reads process.env; copying .env alone does not load it.
# Never commit real secrets.
#
# Provider is one of: openai, openai-compat, azure, vllm, ollama, groq,
# openrouter, anthropic, qwen, dashscope, mock.

# Default role for the tools/ai client (for example pnpm loop).
# This is not the identity of the agent that implements the change: declare that
# with --implementer-provider/--implementer-model on pnpm qa:prepare or qa:record.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=

# Cross-model QA role used by pnpm qa:run. MUST differ from the implementer model.
# Falls back to the AI_* values when unset. The mock provider never counts as an
# independent reviewer for pnpm prepr:gate.
AI_QA_PROVIDER=qwen
AI_QA_MODEL=qwen2.5-coder-32b-instruct
AI_QA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_QA_API_KEY=
# Set to true only if the Qwen deployment supports full json_schema response_format.
AI_QA_STRUCTURED_OUTPUTS=false

# Offline mock response (inline JSON or a path to a JSON file) for the mock provider.
AI_MOCK_RESPONSE=
